# Bazel configuration useful for continuous integration jobs.

common:ci --announce_rc
common:ci --show_progress_rate_limit=10
common:ci --remote_download_minimal
common:ci --incompatible_config_setting_private_default_visibility
common:ci --experimental_ui_max_stdouterr_bytes=2000000
common:ci --lockfile_mode=error
build:ci --verbose_failures
build:ci --experimental_convenience_symlinks=ignore
build:ci --show_result=0
build:ci --nostamp
build:ci --experimental_repository_cache_hardlinks
build:ci --incompatible_strict_action_env
build:ci --toolchain_resolution_debug=//elisp/runfiles:runfiles
test:ci --test_output=errors

# Local Variables:
# mode: bazelrc
# End:
