# Bazel configuration shared between main and example repositories.  This should
# be as minimal as possible.

# Bazel configuration useful for continuous integration jobs.
common:ci --announce_rc
common:ci --show_progress_rate_limit=10
common:ci --remote_download_minimal
common:ci --incompatible_config_setting_private_default_visibility
common:ci --experimental_ui_max_stdouterr_bytes=2000000
common:ci --lockfile_mode=error
build:ci --verbose_failures
build:ci --experimental_convenience_symlinks=ignore
build:ci --show_result=0
build:ci --nostamp
build:ci --experimental_repository_cache_hardlinks
build:ci --incompatible_strict_action_env
build:ci --toolchain_resolution_debug=//elisp/runfiles:runfiles
test:ci --test_output=errors
coverage:ci --test_env='VERBOSE_COVERAGE=1'

# Fix coverage on macOS.  See
# https://github.com/bazelbuild/bazel/issues/10457#issuecomment-5871822715.
coverage --enable_platform_specific_config
coverage:macos --experimental_generate_llvm_lcov
coverage:macos --experimental_use_llvm_covmap
coverage:macos --test_env='LLVM_COV=/Library/Developer/CommandLineTools/usr/bin/llvm-cov'
coverage:macos --test_env='LLVM_PROFDATA=/Library/Developer/CommandLineTools/usr/bin/llvm-profdata'

# Support building with Clang-CL on Windows.  See
# https://bazel.build/configure/windows#clang.
build:clang-cl --compiler=clang-cl --host_compiler=clang-cl
build:clang-cl --extra_toolchains='@local_config_cc//:cc-toolchain-x64_windows-clang-cl'
build:clang-cl --extra_execution_platforms='@rules_elisp//elisp/private:windows_clang_cl'
build:clang-cl --repo_env='USE_CLANG_CL=1'

# Work around https://bugs.gnu.org/79489.
# FIXME: Remove once we drop support for Emacs 30 and below.
build --macos_minimum_os=11.0 --host_macos_minimum_os=11.0

# Local Variables:
# mode: bazelrc
# End:
