{{with .GetModuleDocstring -}}
{{if and (gt (len .) 100) (containsRune . '\n') -}}
{{markdown .}}
{{end -}}
{{end -}}

{{range .GetRuleInfo -}}
{{$name := .GetRuleName -}}
#+ATTR_TEXINFO: :options Rule {{$name}} ({{range $i, $e := .GetAttribute}}{{if $i}}, {{end}}{{if .GetMandatory}}{{.GetName}}{{else}}[{{.GetName}}]{{end}}{{end}})
#+BEGIN_deffn
{{template "load" .GetOriginKey -}}
{{.GetDocString | markdown | lstrip -}}
{{with .GetAttribute}}
The ~{{$name}}~ rule supports the following attributes:

{{range .}}{{item "attribute" .}}{{end -}}
{{end -}}
#+END_deffn

{{end -}}

{{range .GetProviderInfo -}}
{{$name := .GetProviderName -}}
#+ATTR_TEXINFO: :options Provider {{$name}}{{range .GetFieldInfo}} {{.GetName}}{{end}}
#+BEGIN_deftp
{{template "load" .GetOriginKey -}}
{{.GetDocString | markdown | lstrip -}}
{{with .GetFieldInfo}}
The ~{{$name}}~ provider has the following fields:

{{range .}}{{item "field" .}}{{end -}}
{{end -}}
#+END_deftp

{{end -}}

{{range .GetFuncInfo -}}
#+ATTR_TEXINFO: :options {{.GetFunctionName}} ({{range $i, $p := .GetParameter}}{{if $i}}, {{end}}{{if $p.GetMandatory}}{{.GetName}}{{else}}[{{.GetName}}]{{end}}{{end}})
#+BEGIN_defun
{{template "load" .GetOriginKey -}}
{{.GetDocString | markdown | lstrip -}}
{{range .GetParameter}}{{item "parameter" .}}{{end -}}
{{with .GetReturn.GetDocString -}}
Returns: {{markdown .}}

{{end -}}
{{requireEmpty .GetDeprecated.GetDocString -}}
#+END_defun

{{end -}}

{{range .GetAspectInfo -}}
#+ATTR_TEXINFO: :options Aspect {{.GetName}}{{range .GetAttribute}} {{if .GetMandatory}}{{.GetName}}{{else}}[{{.GetName}}]{{end}}{{end}}
#+BEGIN_deffn
{{template "load" .GetOriginKey -}}
{{.GetDocString | markdown | lstrip}}
{{with .GetAspectAttribute -}}
This aspect propagates along the following attributes: {{range $i, $a := .}}{{if $i}}, {{end}}~{{$a}}~{{end}}
{{end}}
{{range .GetAttribute}}{{template "attribute" .}}{{end -}}
#+END_deffn

{{end -}}

{{range .GetModuleExtensionInfo -}}
{{$extName := .GetExtensionName}}
#+ATTR_TEXINFO: :options {Module extension} {{$extName}}{{range .GetTagClass}} {{.GetTagName}}{{end}}
#+BEGIN_deftp

#+BEGIN_SRC bazel-module
{{$extName}} = use_extension("{{.GetOriginKey.GetFile}}", "{{$extName}}")
#+END_SRC

{{.GetDocString | markdown | lstrip -}}
{{with .GetTagClass}}
The ~{{$extName}}~ module extension provides the following tag classes:

{{range . -}}
{{$tagName := .GetTagName}}
#+ATTR_TEXINFO: :options {Tag class} {{$extName}} {{$tagName}} ({{range $i, $e := .GetAttribute}}{{if $i}}, {{end}}{{if .GetMandatory}}{{.GetName}}{{else}}[{{.GetName}}]{{end}}{{end}})
#+BEGIN_defop
{{.GetDocString | markdown | lstrip -}}
{{with .GetAttribute}}
The ~{{$tagName}}~ tag class supports the following attributes:

{{range .}}{{item "attribute" .}}{{end -}}
#+END_defop

{{end -}}
{{end -}}
{{end -}}
#+END_deftp

{{end -}}

{{range .GetRepositoryRuleInfo -}}
{{$name := .GetRuleName}}
#+ATTR_TEXINFO: :options {Repository rule} {{$name}} ({{range $i, $e := .GetAttribute}}{{if $i}}, {{end}}{{if .GetMandatory}}{{.GetName}}{{else}}[{{.GetName}}]{{end}}{{end}})
#+BEGIN_deffn
{{template "load" .GetOriginKey -}}
{{.GetDocString | markdown | lstrip}}
{{with .GetAttribute}}
The ~{{.GetRuleName}}~ repository rule supports the following attributes:

{{range .}}{{item "attribute" .}}{{end -}}
{{end -}}
{{with .GetEnviron}}
It depends on the following environment variables: {{range $i, $v := .}}{{if $i}}, {{end}}{{$v}}{{end}}
{{- end}}
#+END_deffn

{{end -}}

{{range .GetMacroInfo -}}
{{$name := .GetMacroName}}
#+ATTR_TEXINFO: :options {{$name}} ({{range $i, $a := .GetAttribute}}{{if $i}}, {{end}}{{if $a.GetMandatory}}{{.GetName}}{{else}}[{{.GetName}}]{{end}}{{end}})
#+BEGIN_defmac
{{template "load" .GetOriginKey -}}
{{.GetDocString | markdown | lstrip -}}
{{with .GetAttribute}}
The ~{{$name}}~ macro supports the following attributes:

{{range .}}{{item "attribute" .}}{{end -}}
{{end -}}
#+END_defmac

{{end -}}

{{define "field" -}}
~{{.GetName}}~ :: {{.GetDocString | markdown | trimSpace | requirePeriod -}}
{{end -}}

{{define "parameter" -}}
{{.GetName}} :: {{.GetDocString | markdown | trimSpace | requirePeriod}}  {{.GetMandatory | mandatory | capitalize}}{{with .GetDefaultValue}}; default: ~{{.}}~{{end}}.
{{- end -}}

{{define "load"}}
#+BEGIN_SRC bazel-starlark
load("{{requireNonEmpty .GetFile}}", "{{requireNonEmpty .GetName}}")
#+END_SRC

{{end -}}

{{define "attribute" -}}
{{if not (hasPrefix .GetDocString "Deprecated;") -}}
~{{.GetName}}~ :: {{.GetDocString | markdown | trimSpace | requirePeriod}}  {{.GetType | attributeType}}; {{.GetMandatory | mandatory -}}
{{if .GetNonconfigurable}}; nonconfigurable{{end -}}
{{with .GetDefaultValue}}; default: ~{{.}}~{{end -}}
{{with .GetProviderNameGroup -}}
{{with exactlyOne . -}}
; required providers: {{range $i, $n := .GetProviderName}}{{if $i}}, {{end}}~{{$n}}~{{end -}}
{{end -}}
{{end -}}
.{{end -}}
{{end -}}
